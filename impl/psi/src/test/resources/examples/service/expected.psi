server:
  host: 0.0.0.0
  port: 8080
  tls:
    enabled: true
    protocols:
      - TLSv1.2
      - TLSv1.3
db:
  host: db.internal
  port: 5432
  url: jdbc:postgresql://db.internal:5432/orders
  pool:
    min: 2
    max: 16
routes: @ordered
  - path: /api
    to: backend
    timeout: @duration 5s
  - path: /
    to: static
admins:
  - alice
  - bob
