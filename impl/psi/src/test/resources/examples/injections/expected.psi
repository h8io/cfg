defaults:
  host: localhost
  port: 5432
  pool:
    size: 10
    timeout: 30
primary:
  host: localhost
  port: 6432
  pool:
    size: 20
    timeout: 30
replica:
  host: localhost
  port: 6432
  pool:
    size: 20
    timeout: 30
monitoring:
  interval: 10s
audited:
  host: localhost
  port: 6432
  pool:
    size: 20
    timeout: 30
  interval: 10s
hosts:
  - a
  - b
all:
  - first
  - a
  - b
  - last
groups:
  - - a
    - b
  - - backup
flat:
  - a
  - b
  - localhost
  - - a
    - b
  - - a
    - b
copy:
  - a
  - b
