defaults:
  host: localhost
  port: 5432
  pool { size: 10, timeout: 30 }

// marked with a `*` among fields, a substitution puts the fields of the map there, as if written there;
// those below override them
primary:
  $defaults*
  port: 6432
  pool.size: 20

// unmarked after a key it is the key's value: a graft, which copies the node whole
replica: $primary

// two or more marked alone in a block: the fields of the maps they find, merged in turn
monitoring { interval: 10s }
audited:
  $primary*
  $monitoring*

hosts: [a, b]
// marked after a `- ` or in brackets it puts the elements of a sequence there; unmarked it is one element
all:
  - first
  - $hosts*
  - last
groups:
  - $hosts
  - [backup]
flat: [$hosts*, $defaults.host, [$hosts*], $hosts]

// marked after a key it makes a node of what it finds, a map or a sequence, its tags left behind
copy: $hosts*
