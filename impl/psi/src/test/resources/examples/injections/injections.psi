defaults:
  host: localhost
  port: 5432
  pool { size: 10, timeout: 30 }

// a substitution alone among fields puts the fields of the map there, as if written there; those below override them
primary:
  $defaults
  port: 6432
  pool.size: 20

// alone after a key it is the key's value: a graft, which copies the node whole
replica: $primary

// two or more alone in a block: the fields of the maps they find, merged in turn
monitoring { interval: 10s }
audited:
  $primary
  $monitoring

hosts: [a, b]
// alone on its line among `- ` elements it puts the elements of a sequence there; after a `- ` it is one element
all:
  - first
  $hosts
  - last
groups:
  - $hosts
  - [backup]
// in brackets it puts the elements of a sequence it finds, and anything else as one element
flat: [$hosts, $defaults.host, [$hosts]]
