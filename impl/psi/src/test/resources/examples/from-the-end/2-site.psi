hosts.site: [db3]

// a sequence gathered from both sources; an index after a '-' counts from its end, -1 the last element
all: [$hosts.base*, $hosts.site*]
primary: $all[0]
fallback: $all[-1]
before-fallback: $all[-2]
// optional: nothing before the first element, and the field is left out
none: $?all[-4]
