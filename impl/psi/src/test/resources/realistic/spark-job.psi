// A nightly aggregation job on Spark.

job {
  name: daily-revenue
  schedule: "0 2 * * *"
  owner: data-platform
}

paths {
  root: "s3a://warehouse/revenue"
  input: [
    "${paths.root}/raw/orders"
    "${paths.root}/raw/refunds"
  ]
  output: "${paths.root}/daily"
  checkpoint: "${paths.root}/_checkpoints/${job.name}"
}

spark {
  master: yarn
  conf {
    `spark.executor.memory`: 8g
    `spark.executor.cores`: 4
    `spark.sql.shuffle.partitions`: 400
    `spark.sql.sources.partitionOverwriteMode`: dynamic
    `spark.serializer`: org.apache.spark.serializer.KryoSerializer
  }
}

query: """<
  SELECT order_date, currency, SUM(amount) AS revenue
  FROM orders
  WHERE status = 'paid'
  GROUP BY order_date, currency
  """

alerts {
  on-failure: [@email "data-oncall@example.com", @slack "#data-alerts"]
  retries: 3
}
